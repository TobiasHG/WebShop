@page
@model WebShop.Pages.Auth.loginModel
@{
}
<h1>Login</h1>

@if (Model.ErrorMessage != null)
{
    <p style="color:red">@Model.ErrorMessage</p>
}

<form method="post">
    <label for="email">Email:</label>
    <br />
    <input name="email" type="text"/>
    <br /><br />
    <label for="password">Password:</label>
    <br />
    <input name="password" type="password"/>

    <br /><br />
    <button type="submit">Login</button>
</form>

<p>Har du ikke en konto? <a asp-page="/Auth/Register">Opret en konto</a></p>
<p>Glemt din adgangskode? <a asp-page="/Auth/RequestResetPassword">Nulstil adgangskode</a></p>