@page
@model WebShop.Pages.Auth.ResetPasswordModel
@{
}

<h1>Nulstil adgangskode</h1>

@if (Model.Success)
{
    <p>Din adgangskode er ændret.</p>
    <a asp-page="/Auth/Login">Gå til login</a>
}
else if (string.IsNullOrWhiteSpace(Model.Token))
{
    <p>Linket er ugyldigt.</p>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <input type="hidden" asp-for="Token" />

        <div>
            <label asp-for="NewPassword">Ny adgangskode</label>
            <input asp-for="NewPassword" />
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword">Gentag adgangskode</label>
            <input asp-for="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit">Skift adgangskode</button>
    </form>
}