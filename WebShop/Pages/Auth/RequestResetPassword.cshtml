@page
@model WebShop.Pages.Auth.RequestResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<h1>Reset password</h1>

@if( Model.ResetLink != null)
{
    <p>Reset link: <a href="@Model.ResetLink">@Model.ResetLink</a></p>
}

@if (Model.Submitted)
{
    <p>If an account with that email exists, a reset link has been sent.</p>
}
else
{
    <form method="post">
        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit">Send reset link</button>
    </form>
}
